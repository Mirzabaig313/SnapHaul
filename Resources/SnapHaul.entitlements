<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox OFF — required for USB device access via IOKit -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- USB device access for MTP/ADB -->
    <key>com.apple.security.device.usb</key>
    <true/>
    <!-- User-selected file access for ingest destinations -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- App group shared with File Provider extension -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.snaphaul</string>
    </array>
    <!-- XPC Mach service — allows the host app to register this service name -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.snaphaul.app.xpc</string>
    </array>
</dict>
</plist>
