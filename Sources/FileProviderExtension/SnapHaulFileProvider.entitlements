<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox is required for app extensions -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- App group shared with host app for UserDefaults and XPC -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.snaphaul</string>
    </array>
    <!-- NOTE: com.apple.developer.fileprovider.testing-mode requires a paid
         Apple Developer account ($99/year). Remove this comment and add the
         key back when you have a paid account:
         <key>com.apple.developer.fileprovider.testing-mode</key>
         <true/>
    -->
</dict>
</plist>
